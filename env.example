# nbrain configuration. Copy to $BRAIN_HOME/env (default ~/.brain/env) and edit; every bin/run-*.sh script and the CLI
# load it. Nothing here is a secret except where marked: keep the file chmod 600 if you put role passwords in it.

# Who the brain is about. Prompts, tool descriptions and rendered lines use these.
OWNER_NAME=Alex
OWNER_FULL_NAME="Alex Rivera"
OWNER_PRONOUNS=they/them/their
# What the owner calls their assistant: the bots and agents that read the brain.
ASSISTANT_NAME="the assistant"
# The owner's time zone: "this morning", days and every rendered time are in it.
TZ=America/New_York

# This file lives at $BRAIN_HOME/env; BRAIN_HOME (default ~/.brain) holds the data, logs, the curated context repo
# (context/), captures and eval files. Set BRAIN_HOME in your shell, not here, to keep a brain somewhere else.

# Postgres with pg_search (ParadeDB) and pgvector: `docker compose up -d` from the repo starts one on 5433.
# The superuser URL is used by ingest and the CLI only; memory-mcp gets its own roles below.
DATABASE_URL=postgresql://nbrain:nbrain@127.0.0.1:5433/nbrain
# memory-mcp's roles (`nbrain init` creates them and prints these lines). Secret: or set KEYCHAIN_PREFIX instead (macOS).
# MEMORY_RO_DATABASE_URL=postgres://memory_ro:<password>@127.0.0.1:5433/nbrain
# MEMORY_WRITER_DATABASE_URL=postgres://memory_writer:<password>@127.0.0.1:5433/nbrain
# KEYCHAIN_PREFIX=nbrain-memory      # login Keychain items <prefix>-ro (account memory_ro) and <prefix>-writer (memory_writer)
MEMORY_MCP_PORT=8830
# PUBLIC_URL=https://your-device.your-tailnet.ts.net:10000  # HTTPS origin for OAuth discovery and /mcp; enables OAuth with OWNER_TAILSCALE_LOGIN.
# OWNER_TAILSCALE_LOGIN=you@example.com                   # Exact Tailscale owner login allowed to approve OAuth grants from a tailnet device.

# Embeddings: Qwen3-Embedding-0.6B through Ollama (`ollama pull qwen3-embedding:0.6b`).
OLLAMA_URL=http://127.0.0.1:11434
# The search judge, Clef on Workers AI (Cloudflare): says which hits answer a query. The token needs Workers AI access.
# Secret: or keep it in the login Keychain item <KEYCHAIN_PREFIX>-cf-ai (macOS). Without it search has no judge.
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Chat models for records, library cards, the curator and now.md: any OpenAI-compatible endpoint, tried in order.
LLM_URLS=https://openrouter.ai/api
# LLM_API_KEY=sk-...                 # secret; or LLM_API_KEY_FILE=/path/to/key
# Per-role model ("model" or "model@thinking"); defaults in src/models.ts.
# MODEL_READING=anthropic/claude-haiku-4.5
# MODEL_EXTRACTION=anthropic/claude-haiku-4.5
# MODEL_CURATOR=anthropic/claude-sonnet-4.5@low

# now.md, rewritten each morning: repos with commits in the last week under these folders (colon list; each folder and
# its children), and desks under NOW_DESKS (memory/<desk>/journal.md, plus a <desk>/ folder when it has one).
# NOW_ROOTS=$HOME/code
# NOW_DESKS=$HOME/assistant
# The command that sends the owner a message (the weekly one), text on stdin; split like a shell line, not run in one.
# BRAIN_NOTIFY=mail -s "Your brain this week" you@example.com

# Connectors to run (comma list): gmail, imessage, calendar (through an Executor MCP server; its CLI key is read from
# ~/.executor/v2/cli/keys.json), x (bookmarks via the xurl CLI), omp (your own omp coding sessions). Leave empty to
# start with captures, skills and notes only.
CONNECTORS=
# EXECUTOR_MCP_URL=http://127.0.0.1:4312/mcp
# OMP_SESSIONS=$HOME/.omp/agent/sessions

# Optional readers on PATH or here: yt-dlp (YouTube transcripts), xurl (X), and a rendering page reader for
# JavaScript-heavy pages and the pages X posts link to: a command answering
# `read <urls> --json --lane <name> --max-wait <s> --max-chars 0` (without it, thin pages are kept as read).
# YTDLP_BIN=yt-dlp
# XURL_BIN=xurl
# PAGE_READER=web

# Backups (bin/backup.sh): any restic repository.
# RESTIC_REPOSITORY=rest:http://backup-host:8000/nbrain
# RESTIC_PASSWORD_FILE=$BRAIN_HOME/restic-password

# Postgres container for bin/backup.sh's pg_dumpall.
PG_CONTAINER=nbrain-postgres-1
