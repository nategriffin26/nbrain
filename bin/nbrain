#!/bin/bash
# The nbrain CLI (src/cli.ts) with $BRAIN_HOME/env loaded. Put this directory on PATH, or symlink this file.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export BRAIN_HOME="${BRAIN_HOME:-$HOME/.brain}"
if [ -f "$BRAIN_HOME/env" ]; then set -a; source "$BRAIN_HOME/env"; set +a; fi
exec "$ROOT/node_modules/.bin/tsx" "$ROOT/src/cli.ts" "$@"
